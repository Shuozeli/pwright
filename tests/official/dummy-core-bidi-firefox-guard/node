#!/usr/bin/python3
"""Guard the pinned BiDi Firefox --profile launch of the exit-1 Node asset."""

import ctypes
import hashlib
import json
import os
import subprocess
import sys
from pathlib import Path


class ProcessInfo(ctypes.Structure):
    _fields_ = [
        ("pid", ctypes.c_uint32),
        ("ppid", ctypes.c_uint32),
        ("pgid", ctypes.c_uint32),
        ("status", ctypes.c_uint32),
        ("comm", ctypes.c_char * 16),
        ("flags", ctypes.c_uint32),
        ("uid", ctypes.c_uint32),
        ("gid", ctypes.c_uint32),
        ("ruid", ctypes.c_uint32),
        ("rgid", ctypes.c_uint32),
        ("svuid", ctypes.c_uint32),
        ("svgid", ctypes.c_uint32),
        ("reserved", ctypes.c_uint32),
    ]


LIBPROC = ctypes.CDLL("/usr/lib/libproc.dylib", use_errno=True)
LIBPROC.proc_pidinfo.argtypes = [
    ctypes.c_int,
    ctypes.c_int,
    ctypes.c_uint64,
    ctypes.c_void_p,
    ctypes.c_int,
]
LIBPROC.proc_pidinfo.restype = ctypes.c_int
LIBPROC.proc_pidpath.argtypes = [ctypes.c_int, ctypes.c_void_p, ctypes.c_uint32]
LIBPROC.proc_pidpath.restype = ctypes.c_int


def process_snapshot(pid: int) -> dict[str, object]:
    info = ProcessInfo()
    read = LIBPROC.proc_pidinfo(pid, 13, 0, ctypes.byref(info), ctypes.sizeof(info))
    executable = ctypes.create_string_buffer(4096)
    path_size = LIBPROC.proc_pidpath(pid, executable, len(executable))
    if read != ctypes.sizeof(info) or info.pid != pid or path_size <= 0:
        raise ValueError("BiDi Firefox process snapshot is missing")
    return {
        "pid": pid,
        "ppid": int(info.ppid),
        "uid": int(info.uid),
        "executable": executable.value.decode(),
    }


def ancestry(harness_pid: int) -> list[dict[str, object]]:
    chain = []
    pid = os.getpid()
    for _ in range(12):
        entry = process_snapshot(pid)
        if entry["uid"] != os.getuid() or (chain and chain[-1]["ppid"] != pid):
            raise ValueError("BiDi Firefox process ancestry differs")
        chain.append(entry)
        if pid == harness_pid:
            return chain
        pid = int(entry["ppid"])
        if pid < 2:
            break
    raise ValueError("BiDi Firefox ancestry does not reach harness")


def profile_data_from_args(arguments: list[str]) -> dict[str, object]:
    """Require one live, owned profile selected with the two-dash spelling."""
    forbidden = ("-profile", "-profile=", "--profile=", "--user-data-dir")
    if any(arg == forbidden[0] or arg.startswith(forbidden[1:]) for arg in arguments):
        raise ValueError("BiDi Firefox launch has an unpinned profile option")
    positions = [index for index, arg in enumerate(arguments) if arg == "--profile"]
    if len(positions) != 1 or positions[0] + 1 >= len(arguments):
        raise ValueError("BiDi Firefox launch lacks one --profile path")
    profile = Path(arguments[positions[0] + 1])
    if not profile.is_absolute():
        raise ValueError("BiDi Firefox --profile path is not absolute")
    if not profile.is_dir() or profile.is_symlink():
        raise ValueError("BiDi Firefox profile is not a live owned directory")
    stat = profile.stat()
    if stat.st_uid != os.getuid():
        raise ValueError("BiDi Firefox profile has another owner")
    return {
        "path": str(profile),
        "device": stat.st_dev,
        "inode": stat.st_ino,
        "uid": stat.st_uid,
    }


def main() -> int:
    asset = Path(os.environ["PWRIGHT_BIDI_FIREFOX_GUARD_ASSET"])
    receipt = Path(os.environ["PWRIGHT_BIDI_FIREFOX_GUARD_PROCESS_RECEIPT"])
    real_node = Path(os.environ["PWRIGHT_BIDI_FIREFOX_GUARD_REAL_NODE"])
    real_node_sha256 = os.environ["PWRIGHT_BIDI_FIREFOX_GUARD_NODE_SHA256"]
    engine = os.environ["PWRIGHT_BIDI_DUMMY_ENGINE"]
    project = os.environ["PWRIGHT_BIDI_DUMMY_PROJECT"]
    mode = os.environ["PWRIGHT_BIDI_DUMMY_MODE"]
    run_id = os.environ["PWRIGHT_BIDI_DUMMY_RUN_ID"]
    if (
        engine != "firefox"
        or project
        not in (
            "moz-firefox-beta-library",
            "moz-firefox-library",
            "moz-firefox-nightly-library",
        )
        or mode not in ("candidate", "oracle")
        or len(run_id) != 32
        or any(character not in "0123456789abcdef" for character in run_id)
        or len(sys.argv) < 2
        or Path(sys.argv[1]) != asset
        or asset.is_symlink()
        or not asset.is_file()
        or hashlib.sha256(asset.read_bytes()).hexdigest()
        != "9928a78e7de42f29dfc61783a2f31673b387d7d6ea27cda5bc4472e4338c1f7f"
        or receipt.is_symlink()
        or not receipt.is_file()
        or real_node.is_symlink()
        or not real_node.is_file()
        or len(real_node_sha256) != 64
        or any(character not in "0123456789abcdef" for character in real_node_sha256)
        or hashlib.sha256(real_node.read_bytes()).hexdigest() != real_node_sha256
    ):
        raise ValueError("BiDi Firefox guard rejected an unpinned Node invocation")
    arguments = sys.argv[2:]
    profile_data = profile_data_from_args(arguments)
    harness_pid = int(os.environ["PWRIGHT_BIDI_FIREFOX_GUARD_HARNESS_PID"])
    chain = ancestry(harness_pid)
    child = subprocess.Popen([str(real_node), *sys.argv[1:]])
    child_snapshot = process_snapshot(child.pid)
    result = child.wait()
    if (
        child_snapshot["ppid"] != os.getpid()
        or child_snapshot["uid"] != os.getuid()
        or child_snapshot["executable"] != str(real_node)
    ):
        raise ValueError("BiDi Firefox dummy child ownership differs")
    event = {
        "event": "dummy-node-exited",
        "mode": mode,
        "project": project,
        "engine": engine,
        "runId": run_id,
        "asset": str(asset),
        "exitCode": result,
        "guardPid": os.getpid(),
        "guardParentPid": os.getppid(),
        "childPid": child.pid,
        "childReaped": child.returncode == result,
        "childSnapshot": child_snapshot,
        "ancestry": chain,
        "harnessPid": harness_pid,
        "browserArguments": arguments,
        "browserProfile": profile_data,
    }
    with receipt.open("a") as stream:
        stream.write(json.dumps(event, sort_keys=True) + "\n")
    return result


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        with Path(os.environ["PWRIGHT_BIDI_FIREFOX_GUARD_PROCESS_RECEIPT"]).open("a") as stream:
            stream.write(json.dumps({"event": "guard-error", "message": str(error)}) + "\n")
        raise
